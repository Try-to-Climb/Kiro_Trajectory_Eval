{
  "$schema": "kiro-eval-golden-v2",
  "target_agent": "agent-eval",
  "policy": "B-loose",
  "description": "agent-eval 规则的【结构化意图】版(等价 agent-eval.checks.json)。用 reads/runs/write/dispatches/pipeline/never_* 描述期望,不手写 type/regex。CPN1 因 exclude 需多工具正则,保留底层 type 写法作为逃生口示例。",
  "checks": [
    {"id": "collect_graph", "touches": "*_graph.json", "importance": "required", "as": "读目标 agent graph"},
    {"id": "collect_config", "touches": "*.kiro/agents/*.json", "importance": "recommended", "as": "读目标 agent 配置"},
    {"id": "collect_prompt", "touches": "*.prompt.md", "importance": "recommended", "as": "读目标 prompt"},
    {"id": "read_baseline", "touches": "*baseline.json", "importance": "required", "as": "读评估基线"},

    {"id": "produce_cases", "write": "test_cases_", "importance": "recommended", "as": "产出用例汇总(可能复用已有用例,故 recommended)"},
    {"id": "produce_context", "write": "context.md", "importance": "recommended", "as": "产出 context.md"},

    {"id": "reachability_probe", "runs": "timeout *kiro-cli chat*--agent*", "importance": "required", "as": "派发前可达性探测"},
    {"id": "dispatch", "dispatches": "*", "at_least": 1, "importance": "required", "as": "派发子 agent(≥1)"},

    {"id": "MS_pipeline",
     "pipeline": ["touches *_graph.json", "touches *baseline.json", "runs timeout *kiro-cli chat*", "dispatches *"],
     "importance": "required", "as": "主干:采集→生成→探测→派发 按序"},

    {
      "id": "CPN1_no_eval_script",
      "type": "Forbidden",
      "severity": "forbidden",
      "match": {"action": "run_command", "regex": "python3\\s+\\S*(multi_turn|single_turn)_acp\\.py"},
      "exclude": {"regex": "\\b(cat|head|tail|less|grep|find|wc|ls|sed)\\s+\\S*_acp"},
      "reason_tmpl": "编排器禁止自跑评估脚本(exclude 需多工具正则,保留底层写法)"
    },
    {"id": "CPN2_no_direct_invoke", "never_runs": "kiro-cli chat*<<", "except": "timeout *",
     "as": "编排器禁止直接 kiro-cli chat <<< 调目标(绕过子 agent)"},

    {"id": "efficiency_judge", "judge": "efficiency", "importance": "recommended", "as": "效率(LLM 咨询性评分,--llm 时启用)"},
    {"id": "reasoning_judge", "judge": "reasoning_quality", "importance": "recommended", "as": "推理质量(LLM 咨询性评分)"},
    {"id": "authenticity_judge", "judge": "authenticity", "importance": "recommended", "as": "真实性/抓造假(LLM 咨询性评分)"}
  ]
}
