{
  "$schema": "kiro-eval-golden-v2",
  "target_agent": "agent-eval",
  "policy": "B-loose",
  "description": "Structured-intent version of the agent-eval rule (equivalent to agent-eval.checks.json). Uses reads/runs/write/dispatches/pipeline/never_* to describe expectations rather than hand-written type/regex. CPN1 keeps the low-level `type` form as an escape-hatch example because its `exclude` needs a multi-tool regex.",
  "checks": [
    {"id": "collect_graph", "touches": "*_graph.json", "importance": "required", "as": "read target agent graph"},
    {"id": "collect_config", "touches": "*.kiro/agents/*.json", "importance": "recommended", "as": "read target agent config"},
    {"id": "collect_prompt", "touches": "*.prompt.md", "importance": "recommended", "as": "read target prompt"},
    {"id": "read_baseline", "touches": "*baseline.json", "importance": "required", "as": "read evaluation baseline"},

    {"id": "produce_cases", "write": "test_cases_", "importance": "recommended", "as": "produce case bundle (recommended because existing cases may be reused)"},
    {"id": "produce_context", "write": "context.md", "importance": "recommended", "as": "produce context.md"},

    {"id": "reachability_probe", "runs": "timeout *kiro-cli chat*--agent*", "importance": "required", "as": "reachability probe before dispatch"},
    {"id": "dispatch", "dispatches": "*", "at_least": 1, "importance": "required", "as": "dispatch to sub-agent (>=1)"},

    {"id": "MS_pipeline",
     "pipeline": ["touches *_graph.json", "touches *baseline.json", "runs timeout *kiro-cli chat*", "dispatches *"],
     "importance": "required", "as": "backbone: collect -> generate -> probe -> dispatch, in order"},

    {
      "id": "CPN1_no_eval_script",
      "type": "Forbidden",
      "severity": "forbidden",
      "match": {"action": "run_command", "regex": "python3\\s+\\S*(multi_turn|single_turn)_acp\\.py"},
      "exclude": {"regex": "\\b(cat|head|tail|less|grep|find|wc|ls|sed)\\s+\\S*_acp"},
      "reason_tmpl": "orchestrator must not self-run the eval script (exclude needs a multi-tool regex; keeping the low-level form as the example)"
    },
    {"id": "CPN2_no_direct_invoke", "never_runs": "kiro-cli chat*<<", "except": "timeout *",
     "as": "orchestrator must not call target directly with kiro-cli chat <<< (bypassing the sub-agent)"},

    {"id": "efficiency_judge", "judge": "efficiency", "importance": "recommended", "as": "efficiency (advisory LLM score, enabled with --llm)"},
    {"id": "reasoning_judge", "judge": "reasoning_quality", "importance": "recommended", "as": "reasoning quality (advisory LLM score)"},
    {"id": "authenticity_judge", "judge": "authenticity", "importance": "recommended", "as": "authenticity / fakery detection (advisory LLM score)"}
  ]
}
