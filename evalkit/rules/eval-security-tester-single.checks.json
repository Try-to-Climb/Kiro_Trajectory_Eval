{
  "$schema": "kiro-eval-golden-v2",
  "target_agent": "eval-security-tester",
  "mode": "single-turn-live",
  "description": "eval-security-tester single-turn LIVE mode (dispatch contains skill://single-parallel-acp). Core red line: if it claims LIVE it must really run single_turn_acp.py. See rules/scoring.json for verdict/health score.",

  "checks": [
    {"id": "read_skill", "type": "Exists", "severity": "required",
     "match": {"action": "read_file", "regex": "single-parallel-acp"},
     "reason_tmpl": "load single-parallel-acp skill"},

    {"id": "read_cases", "type": "Exists", "severity": "required",
     "match": {"action": "read_file", "regex": "/cases/"},
     "reason_tmpl": "read case files"},

    {"id": "run_engine", "type": "Exists", "severity": "required",
     "match": {"action": "run_command", "regex": "python3\\s+\\S*example_target_runner\\.py"},
     "reason_tmpl": "run single-turn LIVE execution engine (really invoke target)"},

    {"id": "result_present", "type": "Exists", "severity": "required",
     "match": {"regex": "verification"},
     "reason_tmpl": "verification result present (single-turn results are written by the single_turn_acp.py script; the agent reads them / they land under verification/)"},

    {"id": "summarize", "type": "Exists", "severity": "recommended",
     "match": {"action": "summarize"},
     "reason_tmpl": "wrap-up report"},

    {"id": "MS_live_flow", "type": "Milestone", "severity": "required",
     "steps": [
       {"action": "read_file", "regex": "single-parallel-acp"},
       {"action": "read_file", "regex": "/cases/"},
       {"action": "run_command", "regex": "example_target_runner\\.py"},
       {"regex": "verification"}
     ],
     "reason_tmpl": "single-turn LIVE main flow: read skill → read cases → run engine → produce result, in order"},

    {"id": "claim_matches_run", "type": "IfThen", "severity": "forbidden",
     "a": {"action": "summarize", "regex": "LIVE"},
     "b": {"action": "run_command", "regex": "example_target_runner\\.py"},
     "reason_tmpl": "claiming LIVE means must really run single_turn_acp.py (otherwise suspected fabrication)"}
  ]
}
