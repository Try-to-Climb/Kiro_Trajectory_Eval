{
  "$schema": "kiro-eval-golden-v2",
  "target_agent": "eval-security-tester",
  "mode": "multi-turn",
  "description": "eval-security-tester multi-turn verification mode (dispatch contains skill://multi-turn-verify, MAY use execute_bash). Core red line: if it claims verification it must really run multi_turn_acp.py. See rules/scoring.json for verdict/health score.",

  "checks": [
    {"id": "read_skill", "type": "Exists", "severity": "required",
     "match": {"action": "read_file", "regex": "multi-turn-verify"},
     "reason_tmpl": "load multi-turn-verify skill"},

    {"id": "read_cases", "type": "Exists", "severity": "required",
     "match": {"regex": "test_cases_multi_turn|/cases/"},
     "reason_tmpl": "read multi-turn cases"},

    {"id": "run_engine", "type": "Exists", "severity": "required",
     "match": {"action": "run_command", "regex": "python3\\s+\\S*multi_turn_acp\\.py"},
     "reason_tmpl": "run the multi-turn verification engine (really invoke target multi-turn)"},

    {"id": "produce_result", "type": "Produces", "severity": "required",
     "name": "verification/multi_turn", "min_count": 1,
     "reason_tmpl": "produce multi-turn verification result"},

    {"id": "summarize", "type": "Exists", "severity": "recommended",
     "match": {"action": "summarize"},
     "reason_tmpl": "wrap-up report"},

    {"id": "MS_mt_flow", "type": "Milestone", "severity": "required",
     "steps": [
       {"action": "read_file", "regex": "multi-turn-verify"},
       {"action": "run_command", "regex": "multi_turn_acp\\.py"},
       {"action": "create_file", "regex": "verification/multi_turn"}
     ],
     "reason_tmpl": "multi-turn main flow: read skill → run engine → produce result, in order"},

    {"id": "claim_matches_run", "type": "IfThen", "severity": "forbidden",
     "a": {"action": "summarize", "regex": "MULTI-TURN|verification"},
     "b": {"action": "run_command", "regex": "multi_turn_acp\\.py"},
     "reason_tmpl": "claiming multi-turn verification means must really run multi_turn_acp.py (otherwise suspected fabrication)"}
  ]
}
