# ───────── Python ─────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.mypy_cache/

# ───────── Editor / OS ─────────
.DS_Store
*.swp
.idea/
.vscode/

# ───────── Backups / Temp ─────────
*.bak
*.tmp
*.temp
*.orig

# ───────── Packaging artifacts ─────────
*.tar.gz
*.zip

# ═════════ Real operational data (sensitive: contains internal prompts/paths/command outputs, do not upload) ═════════
# To include small "sanitized samples", place them separately under examples/ and confirm no sensitive info before un-ignoring
traces/
archive/
smoketest/
backups/

# ═════════ Scaffolding / test temp dirs (contain real traces and internal paths, not for release) ═════════
acptest/
hooktest/
eval/
_deprecated_scripts/

# ───────── Local Kiro state (real-time agent config, generated by install.sh) ─────────
# The template for release is in config/traced-agent.json
.kiro/

# ───────── Generated visualization artifacts ─────────
*.png
!docs/**/*.png          # Doc images may go under docs/ and be explicitly kept
orchestration*.png
*_timeline.png

# ───────── Evaluation intermediate artifacts ─────────
*.otlp.json
results.json
*.result.json
